{
  "name": "owcs-stats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "export:static:data": "node scripts/export-static.mjs",
    "build:static": "vite build --mode static",
    "export:static": "node scripts/export-static.mjs && vite build --mode static",
    "export:static:production": "node scripts/export-static.mjs --production && vite build --mode static",
    "test:static-export": "node --test scripts/tests/fetch-json-with-retry.test.mjs",
    "test:liquipedia-url": "node --test src/utils/liquipediaTournament.test.mjs",
    "test:match-schedule": "node --test src/utils/matchScheduleReconciliation.test.mjs",
    "test:team-roster": "node --test src/utils/teamRoster.test.mjs",
    "test:embedded-webview": "node --test src/utils/embeddedWebView.test.mjs",
    "test:season-selection": "node --test src/utils/seasonSelection.test.mjs",
    "test:api-base-url": "node --test src/services/apiBaseUrl.test.mjs",
    "verify:static-bundle": "node scripts/verify-static-bundle.mjs",
    "verify:embedded-webview": "node scripts/verify-embedded-webview.mjs",
    "smoke:static": "node scripts/smoke-static.mjs",
    "preview": "vite preview",
    "lint": "vue-cli-service lint"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@fontsource/oxanium": "^5.2.8",
    "axios": "^1.13.4",
    "core-js": "^3.8.3",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.2",
    "html2canvas": "^1.4.1",
    "playwright-core": "^1.61.1",
    "scrollreveal": "^4.0.9",
    "vee-validate": "^4.5.8",
    "vue": "^3.2.13",
    "vue-router": "^4.0.13",
    "vuex": "^4.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "rollup-plugin-visualizer": "^7.0.0",
    "terser": "^5.46.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
