FROM node:22-bookworm-slim
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.source="https://github.com/Wine-Red/owcs-stats" \
      org.opencontainers.image.revision=$SOURCE_COMMIT
ENV NODE_ENV=production
WORKDIR /app/services/assistant
COPY services/assistant/package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY services/assistant/server ./server
COPY services/assistant/public ./public
COPY docs/public-data-api/openapi.yaml /app/docs/public-data-api/openapi.yaml
USER node
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:4330/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "server/index.js"]
